<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        PlayAuction Dark Material3 Theme
        All themes derive from Theme.Material3.Dark as the base,
        ensuring dark-first design throughout the app.
    -->

    <!-- ==================== Base App Theme ==================== -->
    <style name="Theme.PlayAuction" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary Brand -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_variant</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorPrimaryContainer">#33FF6B2C</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary</item>

        <!-- Secondary Brand -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryVariant">@color/brand_secondary_variant</item>
        <item name="colorOnSecondary">@color/text_on_secondary</item>
        <item name="colorSecondaryContainer">#33FFD166</item>
        <item name="colorOnSecondaryContainer">@color/brand_secondary</item>

        <!-- Tertiary / Accent -->
        <item name="colorTertiary">@color/brand_accent</item>
        <item name="colorOnTertiary">@color/bg_primary</item>
        <item name="colorTertiaryContainer">#2206D6A0</item>
        <item name="colorOnTertiaryContainer">@color/brand_accent</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/surface_default</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_tertiary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Error -->
        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">@color/text_on_primary</item>
        <item name="colorErrorContainer">#33FF1744</item>
        <item name="colorOnErrorContainer">@color/status_error</item>

        <!-- Outline -->
        <item name="colorOutline">@color/border</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <!-- Scrim -->
        <item name="colorScrim">@color/scrim</item>

        <!-- StatusBar & Navigation Bar -->
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Typography — using default Material3 type scale; override in Compose -->
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ==================== Splash Screen Theme ==================== -->
    <!--
        Used as the initial theme for MainActivity so the splash screen
        renders correctly before Compose takes over.
        Requires androidx.core:core-splashscreen.
    -->
    <style name="Theme.PlayAuction.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.PlayAuction</item>
    </style>

    <!-- ==================== BottomSheet Theme ==================== -->
    <style name="Theme.PlayAuction.BottomSheet" parent="Theme.Material3.Dark.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.PlayAuction.BottomSheet</item>
    </style>

    <style name="Widget.PlayAuction.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/bg_tertiary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PlayAuction.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.PlayAuction.BottomSheet" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ==================== Dialog Theme ==================== -->
    <style name="Theme.PlayAuction.Dialog" parent="Theme.Material3.Dark.Dialog">
        <item name="colorSurface">@color/bg_tertiary</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PlayAuction.Dialog</item>
    </style>

    <style name="ShapeAppearance.PlayAuction.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- ==================== Auction Live Badge ==================== -->
    <style name="TextAppearance.PlayAuction.LiveBadge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- ==================== Bid Button ==================== -->
    <style name="Widget.PlayAuction.BidButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

</resources>
