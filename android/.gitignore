# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your repository
# release/

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .idea/modules.xml, .idea/misc.xml -> merge into one
.idea/modules.xml
# Android Studio 4 in .idea/kotlinc.xml
.idea/kotlinc.xml
# Android Studio 3.5+ - local.properties included by default
# .idea/

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Signing keystore - NEVER commit to VCS
release-keystore.jks
debug.keystore

# Version Catalog lockfile
gradle/verification-metadata.xml
gradle/verification-keyring.keys

# Kotlin Multiplatform
.kotlin/

# Node Modules (if any web tooling at root)
node_modules/
